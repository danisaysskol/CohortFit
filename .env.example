# CohortFit — environment template. Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- OpenAI (LLM: only used for NL -> cohort IR + short flag explanations) ---
# The LLM receives ONLY schema/DDL + aggregate summaries. Never patient rows.
OPENAI_API_KEY=sk-your-key-here

# Model IDs — VERIFY current snapshot names/prices on OpenAI's official pricing/models page before locking.
# Tier names below came from 2026 pricing aggregators; confirm before use.
OPENAI_MODEL_PRIMARY=gpt-5.6-terra       # NL -> cohort IR (nested/conditional schema)
OPENAI_MODEL_FALLBACK=gpt-5.6-luna       # short flag explanations / easy queries
OPENAI_MODEL_ESCALATION=gpt-5.6-sol      # only after repeated IR-validation failure

# Determinism (reproducibility is a scored requirement)
OPENAI_TEMPERATURE=0
OPENAI_SEED=42

# --- Data ---
MIMIC_DATA_DIR=./mimic-iv-clinical-database-demo-2.2
DUCKDB_PATH=./backend/data/cohortfit.duckdb

# --- Backend / API ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend ---
# Base URL the Next.js app calls for the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
