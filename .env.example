# CohortFit — environment template. Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- OpenAI (LLM: only used for NL -> cohort IR + short flag explanations) ---
# The LLM receives ONLY the system prompt (a schema description + an itemid reference
# list) plus the user's text. Never patient rows, never summary statistics, never DDL.
# Optional: without a key, /cohort/build uses the disclosed keyword fallback.
OPENAI_API_KEY=sk-your-key-here

# Model IDs — VERIFY current snapshot names/prices on OpenAI's official pricing/models page before locking.
# Tier names below came from 2026 pricing aggregators; confirm before use.
OPENAI_MODEL_PRIMARY=gpt-5.6-terra       # NL -> cohort IR (nested/conditional schema)
OPENAI_MODEL_FALLBACK=gpt-5.6-luna       # retried if the primary model errors (then keyword parser)

# Reasoning effort for the NL->IR call (gpt-5.6 reasoning models reject a custom
# temperature, so none is sent; reproducibility comes from the deterministic compiler).
OPENAI_REASONING_EFFORT=low

# --- Data ---
MIMIC_DATA_DIR=./mimic-iv-clinical-database-demo-2.2

# --- Backend / API ---
# Comma/JSON list of allowed CORS origins (dev default is "*"; tighten for a real deploy).
CORS_ALLOW_ORIGINS=["*"]

# --- Frontend ---
# Base URL the Next.js app calls for the FastAPI backend (inlined at build time).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
