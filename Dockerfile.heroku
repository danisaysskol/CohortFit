# Production image for the CohortFit backend on Heroku (container stack).
#
# Build context is the REPO ROOT (see heroku.yml), which lets us bundle both the
# backend code and the committed, openly-licensed MIMIC-IV Demo v2.2 dataset into
# one self-contained image — so the in-memory DuckDB is built at startup with no
# external data dependency (matches the docker-compose model, but data is copied
# in rather than mounted).
#
# Heroku injects $PORT at runtime; uvicorn binds to it (falls back to 8000 for a
# plain local `docker run`).
FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
COPY mimic-iv-clinical-database-demo-2.2 /data

ENV MIMIC_DATA_DIR=/data \
    PYTHONUNBUFFERED=1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
